<Project>
  <PropertyGroup>
    <Version>0.7.1</Version>
    <!-- Embedded symbols keep line numbers in stack traces without shipping .pdb files next to the executable. -->
    <DebugType>embedded</DebugType>
    <!-- Without this the SDK appends the commit hash to the informational version a future updater would compare. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
