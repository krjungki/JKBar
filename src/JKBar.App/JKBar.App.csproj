<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The SDK version pins WinRT projections for the media session APIs; 19041 is the oldest that carries them. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>JKBar</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Background GC trades memory for pause time, which an always-resident bar does not need. -->
    <ConcurrentGarbageCollector>false</ConcurrentGarbageCollector>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
    <!-- WFO0003 wants DPI set from code; it stays in the manifest so it applies before the first window exists. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Managed assemblies are bundled into the host so a portable copy is a handful of files instead of 250. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Native libraries stay beside the executable: self-extracting them would unpack into TEMP on every new build. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Compression saves disk but costs private working set, which this resident tool cannot afford. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Reference XML docs and symbols are not part of a release. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <!-- The WPF variant of WebView2 is dropped below, which is what this conflict is about. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JKBar.Core\JKBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hand-drawn pet frames ship inside the assembly so a portable copy stays a single executable. -->
    <EmbeddedResource Include="Assets\pet-dog.png" LogicalName="JKBar.App.Assets.pet-dog.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- WPF is banned here: it creates a Direct3D device and pins the display driver, blocking hybrid GPU switching. -->
  <Target Name="DropWebView2Wpf" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(FileName)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
